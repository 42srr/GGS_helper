# ========================================
# GGS Helper - Deploy Environment Variables
# ========================================

# --- PostgreSQL ---
POSTGRES_DB=ggs_helper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=3433

# --- Backend ---
BACKEND_PORT=3432
JWT_SECRET=changeme_generate_with_openssl_rand_base64_32
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost

# --- Admin (첫 배포 시 관리자 계정 자동 생성) ---
ADMIN_ID=admin
ADMIN_PASSWORD=changeme_admin_password

# --- Frontend ---
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
